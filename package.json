{
  "name": "thanksgiving",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Thanksgiving plan: prep days, shopping list, day-of timeline with alarms, and recipes in cooking mode",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "test": "node --test tests/unit.test.mjs && node tests/e2e.mjs",
