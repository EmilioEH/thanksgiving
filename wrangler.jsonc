{
  // Static app in ./public plus a small Worker for the shared kitchen state.
  // Each "kitchen" (one Thanksgiving) is a Durable Object named by the
  // unguessable id in its link, so whoever has the link shares one checklist.
  "name": "thanksgiving",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /k/<id> is a page of the app, so unknown navigations get index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "KITCHEN", "class_name": "Kitchen" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Kitchen"] }]
}
